# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: The Base URL of your Supabase project.
# Setup your project in Supabase dashboard and copy your Project URL.
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_ANON_KEY: Your Anon/Public client-side API Key for Supabase.
# Setup your project in Supabase dashboard and copy your Anon Public Key.
SUPABASE_ANON_KEY=your-anon-public-key-here

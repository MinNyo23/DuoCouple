# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUPABASE_URL: The Base URL of your Supabase project.
# Setup your project in Supabase dashboard and copy your Project URL.
SUPABASE_URL=https://xmikjxgzxbdmfjxiqanx.supabase.co

# SUPABASE_ANON_KEY: Your publishable/anon client-side key for Supabase.
# NEVER put a Supabase secret/service_role key in this file or in the APK.
# Setup your project in Supabase dashboard and copy your Anon Public Key.
SUPABASE_ANON_KEY=your-anon-public-key-here

# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Android app + server: set your real publishable (anon) key here before building the APK.
# Never commit `.env` or paste the service_role key into the mobile app.
SUPABASE_URL=https://xmikjxgzxbdmfjxiqanx.supabase.co
SUPABASE_ANON_KEY=your-publishable-key-here

# Required only by api/users.js. Never expose this as VITE_* or ship it in Android.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Vite dashboard variables. Configure these in Vercel for the web project.
VITE_SUPABASE_URL=https://xmikjxgzxbdmfjxiqanx.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key-here
